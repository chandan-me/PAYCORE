# PAYCORE Platform Configuration
APP_ENV=development
DEBUG=true

# Database (PostgreSQL for production, SQLite for local dev)
DATABASE_URL=sqlite+aiosqlite:///./paycore.db
# DATABASE_URL=postgresql+asyncpg://postgres:password123@localhost:5432/paycore

# Redis Queue & Caching
REDIS_URL=redis://localhost:6379/0

# Security Secrets
JWT_SECRET_KEY=paycore_super_secret_jwt_key_2026_change_in_production_32bytes
JWT_ALGORITHM=HS256
PAYCORE_ENCRYPTION_KEY=paycore_secret_encryption_key_32b
WEBHOOK_SIGNING_SECRET=whsec_paycore_live_webhook_signature_secret_key

# URLs
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000

# Sandbox Environment
SANDBOX_ENABLED=true
