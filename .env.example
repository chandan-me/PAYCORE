# PAYCORE Platform Configuration (MySQL 8.0+ Monolithic Stack)
APP_ENV=development
DEBUG=true

# Database (MySQL 8.0+ with aiomysql async driver)
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/paycore
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=paycore
MYSQL_USER=root
MYSQL_PASSWORD=password

# Redis Queue & Caching
REDIS_URL=redis://localhost:6379/0

# Celery Background Workers
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security & JWT Authentication
JWT_SECRET_KEY=paycore_super_secret_jwt_key_2026_change_in_production_32bytes
JWT_ALGORITHM=HS256
PAYCORE_ENCRYPTION_KEY=paycore_secret_encryption_key_32b
WEBHOOK_SIGNING_SECRET=whsec_paycore_live_webhook_signature_secret_key

# Google OAuth 2.0 Credentials (Get from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Live Payment Provider Credentials (Optional / Environment Configured)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Application URLs
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000

# Sandbox Environment
SANDBOX_ENABLED=true
